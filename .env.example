# Weather API (Optional - defaults to keyless Open-Meteo API)
VITE_OPENWEATHER_API_KEY=

# News API Key (Optional - defaults to rich fallback demo news engine)
VITE_NEWS_API_KEY=

# Mapbox / Custom Map Key (Optional - defaults to OpenStreetMap)
VITE_MAP_API_KEY=

# System Mode (true = allow live API calls, false = mock mode)
VITE_ENABLE_LIVE_APIS=true
